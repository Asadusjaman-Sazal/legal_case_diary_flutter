  "@@_section_settingsBatteryGuide": "SETTINGS - BATTERY & AUTO-START GUIDE  |  lib/features/settings/presentation/settings_notifications/battery_setup_guide_screen.dart",
  "settingsBatteryGuide_intro": "Xiaomi, Oppo, Vivo, Realme and similar phones stop background alarms to save battery, so hearing reminders can fail silently. These two or three steps keep them working.",
  "settingsBatteryGuide_autoStartTitle": "Allow Auto-Start",
