# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing: the keystore and its credentials must never be committed
# (android/.gitignore already covers android/key.properties)
*.jks
*.keystore

#Freebuff files
.freebuff/
/.freebuff
/.workbuddy-ai

# Supabase CLI scratch state (migrations and config.toml are committed)
supabase/.temp/
supabase/.branches/

# Local, never-committed connection string for psql apply/verify runs.
# Holds the `lsthasywrdrhuuxnykau` session-pooler URI; see supabase/README.md.
supabase/.env.local

# Build secrets for the app itself, read by
# `flutter run --dart-define-from-file=env.json` (Task 17). Holds the project
# URL, its publishable/anon key and the Google Web client ID. Neither key is
# secret — every build ships them — but a build must never inherit one project's
# key by accident, so they stay out of the repository.
env.json

# Firebase configuration for Cloud Messaging, read by the google-services Gradle
# plugin (admin payment notifications, Task 23 follow-up). Google ships this file
# inside every APK, so it is not a secret — but it is a build input naming one
# Firebase project, and a build must not inherit another project's config by
# accident. Recreated in CI from the GOOGLE_SERVICES_JSON_BASE64 secret; see
# docs/firebase_fcm_setup.md.
android/app/google-services.json
